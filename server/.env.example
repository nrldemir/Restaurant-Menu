# SQLite veritabanı dosyası (prisma/ klasörüne göre)
DATABASE_URL="file:./dev.db"

# JWT imzalama anahtarı - uzun ve rastgele bir değer kullanın
JWT_SECRET="buraya-uzun-rastgele-bir-deger-yazin"

PORT=4000

# Menü linklerinin ve QR kodlarının işaret edeceği frontend adresi.
# "auto": bilgisayarın yerel ağ IP'si otomatik kullanılır (aynı Wi-Fi'deki telefonlardan test için).
# Canlıda gerçek alan adınızı yazın, örn. CLIENT_URL="https://menu.restoraniniz.com"
CLIENT_URL="auto"
